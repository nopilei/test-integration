# Application
APP_NAME=risk-provider-integration
APP_ENV=local
LOG_LEVEL=INFO

# API
API_KEY=super-secret-api-key
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=risk_platform
POSTGRES_USER=risk_platform
POSTGRES_PASSWORD=risk_platform

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Outbox relay
OUTBOX_POLL_INTERVAL_SEC=1.0
OUTBOX_BATCH_SIZE=50
# RabbitMQ: quorum x-delivery-limit before dead-letter to tickets.dlq
RMQ_MAX_ATTEMPTS=3

# Risk-provider integration (in-process mock, see backend/workers/provider_gateway/client.py)
PROVIDER_MOCK_MIN_DELAY_SEC=0.05
PROVIDER_MOCK_MAX_DELAY_SEC=0.4
PROVIDER_MOCK_TRANSPORT_ERROR_RATE=0.05
PROVIDER_MOCK_ACK_ERROR_RATE=0.05
PROVIDER_MOCK_ACCEPT_PROBABILITY=0.7
PROVIDER_MOCK_RECOMMENDATION_MIN_DELAY_SEC=0.2
PROVIDER_MOCK_RECOMMENDATION_MAX_DELAY_SEC=3.0

# Reconciler
RECONCILER_STUCK_AFTER_SEC=60
RECONCILER_POLL_INTERVAL_SEC=15.0
RECONCILER_BATCH_SIZE=100
TICKET_RECOMMENDATION_TIMEOUT_SEC=30

# Monolith (Django) integration — emulated in-process, no HTTP
MONOLITH_MOCK_ERROR_RATE=0.05

# Observability
PROBES_PORT=8080
METRICS_ENABLED=true
